generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  SALESPERSON
}

model User {
  id             String   @id @default(uuid())
  username       String   @unique @db.VarChar(50)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  role           UserRole @default(SALESPERSON)
  isActive       Boolean  @default(true) @map("is_active")
  sessionVersion Int      @default(0) @map("session_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  plasticPriceEditor PlasticPriceEditor?

  @@map("users")
}

model SalespersonMenuPermission {
  menuKey   String   @id @map("menu_key") @db.VarChar(100)
  isVisible Boolean  @default(true) @map("is_visible")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("salesperson_menu_permissions")
}

model Customer {
  id           Int               @id @default(autoincrement())
  code         String            @db.VarChar(50)
  fullName     String            @map("full_name") @db.VarChar(255)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@unique([code])
  @@index([fullName])
  @@map("customers")
}

model ReceiverHistory {
  id           Int      @id @default(autoincrement())
  customerCode String   @map("customer_code") @db.VarChar(50)
  receiver     String   @db.VarChar(255)

  @@unique([customerCode, receiver])
  @@index([customerCode])
  @@map("receiver_history")
}

model Material {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(255)
  packsPerTon  Int      @default(40) @map("packs_per_ton")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("materials")
}

// Intentionally keyed by the material code rather than a foreign key. This
// mirrors the existing warehouse system, where historical inbound entries
// remain intact when a material master record is renamed or deleted.
model InboundRecord {
  id               Int      @id @default(autoincrement())
  code             String   @db.VarChar(50)
  name             String   @db.VarChar(255)
  packCount        Decimal  @map("pack_count") @db.Decimal(12, 2)
  inboundUnitPrice Decimal? @map("inbound_unit_price") @db.Decimal(14, 4)
  taxIncluded      Boolean  @default(false) @map("tax_included")
  createdAt        DateTime @default(now()) @map("created_at")
  sourceType       String?  @map("source_type") @db.VarChar(50)
  sourceId         Int?     @map("source_id")

  @@index([code])
  @@map("inbound_records")
}

model PlasticPriceTable {
  id        String   @id @db.VarChar(50)
  groups    Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("plastic_price_tables")
}

// Per-user grant for editing the home price table. Super admins are allowed
// by role and are not stored here.
model PlasticPriceEditor {
  userId    String   @id @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("plastic_price_editors")
}

// Order/customer/material names are historical snapshots. Manual codes are
// allowed, and deleting master data must not delete a customer's orders.
model CustomerOrder {
  id            Int                 @id @default(autoincrement())
  orderNo       String              @unique @map("order_no") @db.VarChar(50)
  customerCode  String              @map("customer_code") @db.VarChar(50)
  customerName  String              @map("customer_name") @db.VarChar(255)
  receiver      String              @db.VarChar(255)
  orderDate     DateTime            @map("order_date") @db.Date
  isShipped     Boolean             @default(false) @map("is_shipped")
  deductFutures Boolean             @default(false) @map("deduct_futures")
  createdAt     DateTime            @default(now()) @map("created_at")
  items         CustomerOrderItem[]

  @@index([orderDate, createdAt])
  @@index([customerCode])
  @@map("orders")
}

model CustomerOrderItem {
  id        Int           @id @default(autoincrement())
  orderId   Int           @map("order_id")
  code      String        @db.VarChar(50)
  name      String        @db.VarChar(255)
  packCount Decimal       @map("pack_count") @db.Decimal(12, 2)
  unitPrice Decimal       @default(0) @map("unit_price") @db.Decimal(12, 2)
  remark    String?       @db.VarChar(500)
  order     CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

// Backing records for the reference system's customer consignment deduction.
// Quantities are in tons; history entries carry order_id for exact reversal.
model CustomerConsignment {
  id              Int      @id @default(autoincrement())
  orderDate       DateTime @map("order_date") @db.Date
  customerName    String   @default("") @map("customer_name") @db.VarChar(255)
  itemCode        String   @map("item_code") @db.VarChar(100)
  quantity        Decimal  @db.Decimal(18, 8)
  unitPrice       Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  amount          Decimal  @default(0) @db.Decimal(12, 2)
  arrivalDate     DateTime? @map("arrival_date") @db.Date
  storageFeePrice Decimal  @default(0) @map("storage_fee_price") @db.Decimal(10, 2)
  storageFeeDays  Int      @default(0) @map("storage_fee_days")
  storageFeeTotal Decimal  @default(0) @map("storage_fee_total") @db.Decimal(12, 2)
  outboundQuantity Decimal @default(0) @map("outbound_quantity") @db.Decimal(18, 8)
  outboundHistory Json     @default("[]") @map("outbound_history")
  status          String   @default("unfinished") @db.VarChar(20)
  remark          String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([customerName, itemCode, status])
  @@index([orderDate, id])
  @@map("futures")
}

// Payments keep the customer code/name snapshot, including manual and fc_ codes.
// Removing customer master data must not remove the payment history.
model ReceivablePayment {
  id           Int      @id @default(autoincrement())
  customerCode String   @map("customer_code") @db.VarChar(300)
  customerName String   @map("customer_name") @db.VarChar(255)
  amount       Decimal  @db.Decimal(12, 2)
  paymentDate  DateTime @map("payment_date") @db.Date
  remark       String   @default("") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([customerCode, paymentDate, createdAt])
  @@map("payments")
}

// Reference full-container sales source; both warehouse modes count in receivables.
model FullContainerRecord {
  id                 Int       @id @default(autoincrement())
  orderDate          DateTime  @map("order_date") @db.Date
  buyer              String    @db.VarChar(255)
  itemName           String    @map("item_name") @db.VarChar(255)
  quantity           Decimal   @db.Decimal(12, 2)
  unitPrice          Decimal   @default(0) @map("unit_price") @db.Decimal(12, 2)
  amount             Decimal   @default(0) @db.Decimal(12, 2)
  taxIncluded        Boolean   @default(false) @map("tax_included")
  deliveryInfo       String?   @map("delivery_info") @db.VarChar(255)
  warehouseOnArrival Boolean   @default(false) @map("warehouse_on_arrival")
  remark             String?   @db.Text
  supplier           String    @db.VarChar(255)
  supplyOrderDate    DateTime? @map("supply_order_date") @db.Date
  supplyUnitPrice    Decimal   @default(0) @map("supply_unit_price") @db.Decimal(12, 2)
  supplyAmount       Decimal   @default(0) @map("supply_amount") @db.Decimal(12, 2)
  supplyTaxIncluded  Boolean   @default(false) @map("supply_tax_included")
  followStatus       String?   @map("follow_status") @db.VarChar(255)
  delivered          Boolean   @default(false)
  deliveryDate       DateTime? @map("delivery_date") @db.Date
  supplyRemark       String?   @map("supply_remark") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([buyer, orderDate])
  @@map("full_container_records")
}
