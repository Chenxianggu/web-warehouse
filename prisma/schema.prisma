generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  SALESPERSON
}

model User {
  id             String   @id @default(uuid())
  username       String   @unique @db.VarChar(50)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  role           UserRole @default(SALESPERSON)
  isActive       Boolean  @default(true) @map("is_active")
  sessionVersion Int      @default(0) @map("session_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model SalespersonMenuPermission {
  menuKey   String   @id @map("menu_key") @db.VarChar(100)
  isVisible Boolean  @default(true) @map("is_visible")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("salesperson_menu_permissions")
}

model Customer {
  id           Int               @id @default(autoincrement())
  code         String            @db.VarChar(50)
  fullName     String            @map("full_name") @db.VarChar(255)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  receivers    ReceiverHistory[]

  @@unique([code])
  @@index([fullName])
  @@map("customers")
}

model ReceiverHistory {
  id           Int      @id @default(autoincrement())
  customerCode String   @map("customer_code") @db.VarChar(50)
  receiver     String   @db.VarChar(255)
  customer     Customer @relation(fields: [customerCode], references: [code], onUpdate: Cascade, onDelete: Cascade)

  @@unique([customerCode, receiver])
  @@index([customerCode])
  @@map("receiver_history")
}
