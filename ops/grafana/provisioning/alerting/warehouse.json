              "datasourceUid": "warehouse-loki",
              "model": {
                "datasource": {
                  "type": "loki",
                  "uid": "warehouse-loki"
                },
                "expr": "sum by (module) (count_over_time({application=\"warehouse\",environment=\"production\",service_name=\"app\",level=\"ERROR\"} | json | __error__=\"\" | action=\"BUSINESS_WRITE_FAILED\" [5m])) or vector(0)",
                "queryType": "instant",
                "instant": true,
                "refId": "A",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        2
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                }
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "某业务模块最近 5 分钟写入异常达到 3 次",
            "description": "在 Grafana 按 BUSINESS_WRITE_FAILED 和模块筛选；普通校验和预期约束冲突不计入。"
          },
          "labels": {
            "application": "warehouse",
            "environment": "production",
            "severity": "warning"
          },
          "isPaused": false,
          "notification_settings": {
            "receiver": "warehouse-mobile",
            "group_by": [
              "grafana_folder",
              "alertname",
              "environment",
              "module"
            ],
            "group_wait": "10s",
            "group_interval": "1m",
            "repeat_interval": "30m"
          }
        },
