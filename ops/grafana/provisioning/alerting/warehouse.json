{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "warehouse-production",
      "folder": "任仲塑料后台 · 生产报警",
      "interval": "30s",
      "rules": [
        {
          "uid": "warehouse-db-unavailable",
          "title": "数据库连接不可用",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "queryType": "instant",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "warehouse-loki",
              "model": {
                "datasource": {
                  "type": "loki",
                  "uid": "warehouse-loki"
                },
                "expr": "sum (count_over_time({application=\"warehouse\",environment=\"production\",service_name=\"app\",level=\"ERROR\"} | json | __error__=\"\" | action=\"DATABASE_UNAVAILABLE\" [2m])) or vector(0)",
                "queryType": "instant",
                "instant": true,
                "refId": "A",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                }
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "检测到数据库连接异常",
            "description": "检查数据库容器、连接数和最近发布；外部健康检查会独立检测持续不可用。"
          },
          "labels": {
            "application": "warehouse",
            "environment": "production",
            "severity": "critical"
          },
          "isPaused": false,
          "notification_settings": {
            "receiver": "warehouse-mobile",
            "group_by": [
              "grafana_folder",
              "alertname",
              "environment",
              "module"
            ],
            "group_wait": "10s",
            "group_interval": "1m",
            "repeat_interval": "30m"
          }
        },
        {
          "uid": "warehouse-log-storage",
          "title": "认证日志保存失败",
