                },
                "expr": "sum (count_over_time({application=\"warehouse\",environment=\"production\",service_name=\"app\",level=\"ERROR\"} | json | __error__=\"\" | action=\"LOG_STORAGE_FAILED\" [5m])) or vector(0)",
                "queryType": "instant",
                "instant": true,
                "refId": "A",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                }
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "认证日志无法保存至数据库",
            "description": "原始认证事件仍在容器日志中，请检查数据库与日志表写入权限。"
          },
          "labels": {
            "application": "warehouse",
            "environment": "production",
            "severity": "critical"
          },
          "isPaused": false,
          "notification_settings": {
            "receiver": "warehouse-mobile",
            "group_by": [
              "grafana_folder",
              "alertname",
              "environment",
              "module"
            ],
            "group_wait": "10s",
            "group_interval": "1m",
            "repeat_interval": "30m"
          }
        },
        {
          "uid": "warehouse-request-burst",
          "title": "后台请求异常增多",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "queryType": "instant",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "warehouse-loki",
              "model": {
                "datasource": {
                  "type": "loki",
                  "uid": "warehouse-loki"
                },
                "expr": "sum (count_over_time({application=\"warehouse\",environment=\"production\",service_name=\"app\",level=\"ERROR\"} | json | __error__=\"\" | action=\"REQUEST_ERROR\" [5m])) or vector(0)",
                "queryType": "instant",
                "instant": true,
                "refId": "A",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        4
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                }
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "最近 5 分钟服务器请求异常达到 5 次",
            "description": "在 Grafana 按 REQUEST_ERROR 筛选，结合版本、模块和关联编号排查。"
          },
          "labels": {
            "application": "warehouse",
            "environment": "production",
            "severity": "warning"
          },
          "isPaused": false,
          "notification_settings": {
            "receiver": "warehouse-mobile",
            "group_by": [
              "grafana_folder",
              "alertname",
              "environment",
              "module"
            ],
            "group_wait": "10s",
            "group_interval": "1m",
            "repeat_interval": "30m"
          }
        },
        {
          "uid": "warehouse-business-burst",
          "title": "业务写入连续异常",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "queryType": "instant",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
