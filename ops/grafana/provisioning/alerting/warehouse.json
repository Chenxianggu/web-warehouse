  ],
  "contactPoints": [
    {
      "orgId": 1,
      "name": "warehouse-mobile",
      "receivers": [
        {
          "uid": "warehouse-mobile-webhook",
          "type": "webhook",
          "disableResolveMessage": false,
          "settings": {
            "url": "http://notifier:8080/grafana",
            "httpMethod": "POST",
            "authorization_scheme": "Bearer",
            "authorization_credentials": "$ALERT_WEBHOOK_TOKEN",
            "maxAlerts": "20"
          }
        }
      ]
    }
  ]
}
